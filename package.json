{
  "name": "@whitespace/forma-editor",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:php": "php -l forma-editor.php && php -l source/Assets.php && php -l source/Plugin.php",
    "test:php": "php tests/editor-policy.php",
    "test:js": "node --test tests/preview.test.mjs",
    "check": "npm run typecheck && npm run format:check && npm run lint:php && npm run test:php && npm run test:js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@wordpress/api-fetch": "8.1.0",
    "prettier": "^3.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
